# Données réelles (heures, emails) : jamais dans le dépôt, qui est public pour GitHub Pages.
*.xlsx
# Fichiers de reprise de l'historique (données réelles).
reprise*.sql
reprise*.json
# SQL de restauration d'une sauvegarde (données réelles).
restore*.sql
# Sauvegardes (données réelles) : jamais dans le dépôt, même posées là par erreur.
*.json.gz
kilosaurus-temps_*
# Cache local de wrangler.
.wrangler/
~$*

node_modules/
__pycache__/

# Lien local vers le script Apps Script déployé (clasp).
.clasp.json

# Android : sorties de build et clé de signature (à sauvegarder ailleurs, jamais publiée).
android/build/
android/release.keystore
android/keystore.properties
# Réglages propres à la machine (dossier de dépôt de l'APK).
android/local.properties

*.apk

# Mini-fenêtre de bureau : dépendances (Electron).
desktop/node_modules/
